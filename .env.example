# Al Quds Market — Environment Variables
#
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.
#
# These are set in Phase 2 after the Supabase project is created.

# Supabase Project URL (from Project Settings > API)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Supabase Anon Key (public — safe in browser)
# NEVER use the service_role key here.
VITE_SUPABASE_ANON_KEY=<your-anon-key>
